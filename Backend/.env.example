# Copiar a .env.local (ignorado por Git). No usar prefijo VITE_ para secretos.
DB_URL=jdbc:mysql://127.0.0.1:3306/zona_bikers
DB_USERNAME=root
DB_PASSWORD=
JWT_SECRET=
JWT_MINUTES=60
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVER_PORT=8080
# Opcional: crear administrador si el correo todavía no existe.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Catálogo de cuatro productos: se carga únicamente si la tabla está vacía.
SEED_CATALOG=true
