# Frontend: URL completa del endpoint, pública y sin secretos.
# Vacía en desarrollo usa /api/chat; vacía en producción desactiva el chat.
# Ejemplo de producción: https://api.example.com/api/chat
VITE_CHAT_API_URL=

# Solo servidor. Nunca usar VITE_ para la clave ni añadirla al build de Pages.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Servidor independiente: origen exacto de Pages, sin ruta ni barra final.
# Ejemplo: https://usuario.github.io
CHAT_ALLOWED_ORIGIN=
HOST=127.0.0.1
PORT=3001
